APP_NAME=Zedan

# Used only on first launch (empty database) to create the one admin
# account - see database/seeders/ProductionSeeder.php. Set these before
# distributing a packaged build so every install isn't the same default
# password; if left blank, a random password is generated and written
# to storage/logs/laravel.log on first run.
ADMIN_NAME="Clinic Admin"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is used for this local, single-clinic install: zero server setup,
# the whole clinic's data lives in one portable file that is trivial to
# back up alongside the PDF/Excel exports. Migrations avoid SQLite-only
# syntax so the same schema can be pointed at MySQL for a busier/
# multi-clinic deployment by changing these four lines only - see the
# README's "Outgrowing SQLite" section for when to make that switch.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# File-based, not database-backed: every request would otherwise write a
# session row to the same SQLite file as actual patient/appointment data,
# adding write contention for no benefit under real concurrent load.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Backups (PDF/Excel export of the whole clinic) run as a QUEUED job so
# clicking "Backup Now" doesn't tie up the request for however long
# generation takes on a data-heavy clinic. This requires a queue worker
# actually running at all times in production - `php artisan queue:work`,
# kept alive via systemd/supervisor (see README). If you don't want to
# manage a worker process, set this to `sync` instead: backups then run
# immediately/synchronously again (same behavior as before), just with no
# background processing.
QUEUE_CONNECTION=database

# Same reasoning as SESSION_DRIVER - keeps cache reads/writes off the
# same file as clinic data.
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@zedan.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
